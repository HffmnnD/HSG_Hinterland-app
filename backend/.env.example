# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL (XAMPP-Standard: user root, leeres Passwort)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hsg_hinterland
DB_CONNECTION_LIMIT=10

# Auth
# JWT_SECRET mit einem langen, zufälligen Wert ersetzen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-langen-zufaelligen-wert-eintragen
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=token
BCRYPT_SALT_ROUNDS=10

# Cookie-Secure-Flag explizit steuern (Standard: an, wenn NODE_ENV=production).
# In der lokalen Entwicklung über http muss es false sein.
COOKIE_SECURE=false

# Reverse-Proxy: "loopback" (Standard) vertraut nur 127.0.0.1 (Vite-Dev-Proxy).
# Hinter echtem Proxy/LB in Produktion: 1 (Anzahl vorgeschalteter Proxies).
TRUST_PROXY=loopback

# --- nuLiga (HHV – Hessischer Handball-Verband) -----------------------------
# Datenquelle des Handball-Moduls. Die Seitenpfade selbst stehen in
# config/handball.js; hier nur Basis-Adresse und Betriebsparameter.
NULIGA_BASE_URL=https://hhv-handball.liga.nu
NULIGA_APP_PATH=/cgi-bin/WebObjects/nuLigaHBDE.woa/wa

# Cache-Zeiten in Sekunden. Bitte nicht ohne Not verkleinern: jeder Abruf holt
# eine vollstaendige HTML-Seite (40-55 KB) vom Verband.
HANDBALL_TTL_TABLE=900
HANDBALL_TTL_SCHEDULE=900
HANDBALL_TTL_TICKER_LIVE=10
HANDBALL_TTL_TICKER_IDLE=600

# Notreserve: so lange werden die letzten erfolgreichen Daten aufgehoben und
# bei einem Ausfall als "veraltet" ausgeliefert (Standard 24 h).
HANDBALL_STALE_TTL=86400

# Obergrenze der Cache-Eintraege je Ebene (Frisch-Cache und Notreserve).
# Begrenzt den Speicher: ohne Grenze koennte ein angemeldetes Konto ueber viele
# verschiedene IDs beliebig viele Eintraege anlegen, die 24 h liegen blieben.
HANDBALL_MAX_CACHE_KEYS=500

# Abbruch, wenn nuLiga nicht antwortet.
HANDBALL_TIMEOUT_MS=10000

# Spielzeit-Logik: Laenge einer Halbzeit (trennt 1./2. Halbzeit im Ticker) und
# Zeitfenster nach Anwurf, in dem ein Spiel ohne Ergebnis als "laeuft" gilt.
HANDBALL_HALFTIME_MINUTES=30
HANDBALL_LIVE_WINDOW_MINUTES=150
