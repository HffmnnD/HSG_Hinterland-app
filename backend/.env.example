# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL (XAMPP-Standard: user root, leeres Passwort)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hsg_hinterland
DB_CONNECTION_LIMIT=10

# Auth
# JWT_SECRET mit einem langen, zufälligen Wert ersetzen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-langen-zufaelligen-wert-eintragen
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=token
BCRYPT_SALT_ROUNDS=10

# Cookie-Secure-Flag explizit steuern (Standard: an, wenn NODE_ENV=production).
# In der lokalen Entwicklung über http muss es false sein.
COOKIE_SECURE=false
