# Leer lassen für die lokale Entwicklung: dann laufen API-Requests als
# relative /api/... Pfade über den Vite-Dev-Proxy (siehe vite.config.js).
# Das vermeidet CORS- und Cross-Site-Cookie-Probleme, auch beim Testen
# über die LAN-IP vom Handy.
VITE_API_BASE_URL=

# Ziel des Dev-Proxys, falls das Backend woanders läuft.
API_PROXY_TARGET=http://localhost:5000
